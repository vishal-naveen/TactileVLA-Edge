# Copy to .env and fill in. NEVER commit .env.

# Serial ports for the SO-101 arms (macOS: /dev/tty.usbmodem*, Linux: /dev/ttyACM*)
FOLLOWER_PORT=/dev/tty.usbmodemXXXX
LEADER_PORT=/dev/tty.usbmodemYYYY

# Calibration ids - must stay stable forever; they key the calibration files
FOLLOWER_ID=follower_01
LEADER_ID=leader_01

# Hugging Face Hub (for dataset / model push)
HF_USER=
HF_TOKEN=

# AnySkin tactile sensor serial port
ANYSKIN_PORT=
